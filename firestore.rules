rules_version = '2';

// ===============================================================
// Who is who
// ===============================================================
//
// - Teachers sign in with Firebase email/password. Their uid is their /teachers doc id.
// - Students sign in through /api/student-auth/* (name + PIN checked on the server),
//   which issues a Firebase custom token: uid = student doc id, claim role = "student".
// - Admins are the built-in emails below or teachers with isAdmin == true (only an
//   admin can grant that).
//
// Collections:
//   teachers/{teacherId}            owner teacher + admins (public directory is served by /api/public/teachers)
//   teachers/{id}/vocabBanks/{id}   public read; owner teacher writes
//   teachers/{id}/worksheets/{id}   owner teacher + admins only
//   shared_worksheets/{id}          teachers read (answer keys inside); owner teacher writes
//   shared_vocab_banks/{id}         public read; teachers write
//   students/{studentId}            owning teacher, admins, and the student themself (read)
//   assignments/{id}                public read; owning teacher writes
//   submissions/{id}                the student who submitted + their teacher + admins
//   drafts/{id}                     the student only
//   site_suggestions/{id}           teachers create/read; admins manage
//   users/{uid}/**                  the user only
//   student_login_guards/{id}       server only (PIN attempt counter)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isStudent() {
      return signedIn() && request.auth.token.get('role', '') == 'student';
    }

    // A real email/password account (never a student custom token).
    function isTeacherAccount() {
      return signedIn() && !isStudent() && request.auth.token.get('email', '') != '';
    }

    function isTeacher(teacherId) {
      return isTeacherAccount() && uid() == teacherId;
    }

    // Built-in admin emails. Keep in sync with src/config/admins.ts
    // (`npm run check:admins` verifies this).
    function isAdmin() {
      return isTeacherAccount() && (
        request.auth.token.email in ['niroari@gmail.com', 'shichva.app@gmail.com'] ||
        get(/databases/$(database)/documents/teachers/$(uid())).data.get('isAdmin', false) == true
      );
    }

    function changes() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------
    // Teachers
    // ---------------------------------------------------------------
    match /teachers/{teacherId} {
      allow read: if isTeacher(teacherId) || isAdmin();
      // Nobody can make themself an admin.
      allow create: if isTeacher(teacherId) &&
        (request.resource.data.get('isAdmin', false) != true || isAdmin());
      allow update: if (isTeacher(teacherId) && !changes().hasAny(['isAdmin'])) || isAdmin();
      allow delete: if isAdmin();

      match /vocabBanks/{bankId} {
        allow read: if true;
        allow write: if isTeacher(teacherId) || isAdmin();
      }

      // Printable worksheets from the worksheet maker (answer keys inside, so private).
      match /worksheets/{worksheetId} {
        allow read, write: if isTeacher(teacherId) || isAdmin();
      }
    }

    // The teachers' worksheet library: any teacher reads, only the sharing teacher
    // changes or removes their sheet. Students never read it (answer keys inside).
    match /shared_worksheets/{worksheetId} {
      allow read: if isTeacherAccount();
      allow create: if isTeacherAccount() && request.resource.data.ownerId == uid();
      allow update: if (isTeacherAccount() &&
          resource.data.ownerId == uid() &&
          request.resource.data.ownerId == uid()) ||
        isAdmin();
      allow delete: if (isTeacherAccount() && resource.data.ownerId == uid()) || isAdmin();
    }

    match /shared_vocab_banks/{bankId} {
      allow read: if true;
      allow write: if isTeacherAccount();
    }

    // ---------------------------------------------------------------
    // Students (records include the PIN, so never public)
    // ---------------------------------------------------------------
    match /students/{studentId} {
      allow read: if uid() == studentId ||
        (isTeacherAccount() && resource.data.teacherId == uid()) ||
        isAdmin();
      allow create: if (isTeacherAccount() && request.resource.data.teacherId == uid()) || isAdmin();
      allow update: if (isTeacherAccount() &&
          resource.data.teacherId == uid() &&
          request.resource.data.teacherId == uid()) ||
        isAdmin();
      allow delete: if (isTeacherAccount() && resource.data.teacherId == uid()) || isAdmin();
    }

    // ---------------------------------------------------------------
    // Assignments
    // ---------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create: if (isTeacherAccount() && request.resource.data.teacherId == uid()) || isAdmin();
      allow update, delete: if (isTeacherAccount() && resource.data.teacherId == uid()) || isAdmin();
    }

    // ---------------------------------------------------------------
    // Submissions
    // ---------------------------------------------------------------
    match /submissions/{submissionId} {
      allow read: if signedIn() && (
          resource.data.studentId == uid() ||
          resource.data.teacherId == uid() ||
          isAdmin()
        );
      // Students submit their own work; the teacher's grading fields are off limits.
      allow create: if signedIn() &&
        request.resource.data.studentId == uid() &&
        !request.resource.data.keys().hasAny(['grade', 'teacherFeedback', 'reviewedAt']);
      allow update: if signedIn() && (
          (resource.data.studentId == uid() &&
            request.resource.data.studentId == uid() &&
            !changes().hasAny(['grade', 'teacherFeedback', 'reviewedAt'])) ||
          (isTeacherAccount() &&
            resource.data.teacherId == uid() &&
            request.resource.data.teacherId == uid()) ||
          isAdmin()
        );
      allow delete: if (isTeacherAccount() && resource.data.teacherId == uid()) || isAdmin();
    }

    // ---------------------------------------------------------------
    // Drafts (auto-saved work in progress)
    // ---------------------------------------------------------------
    match /drafts/{draftId} {
      allow read, delete: if signedIn() && resource.data.studentId == uid();
      allow create: if signedIn() && request.resource.data.studentId == uid();
      allow update: if signedIn() &&
        resource.data.studentId == uid() &&
        request.resource.data.studentId == uid();
    }

    // ---------------------------------------------------------------
    // Content
    // ---------------------------------------------------------------
    match /unseens/{unseenId} {
      allow read: if true;
      allow write: if isTeacherAccount();
    }

    match /site_suggestions/{suggestionId} {
      allow create, read: if isTeacherAccount();
      allow update, delete: if isAdmin();
    }

    // Private per-user workspace (vocab builder, tutor profile)
    match /users/{userId}/{allUserPaths=**} {
      allow read, write: if signedIn() && uid() == userId;
    }
  }
}
